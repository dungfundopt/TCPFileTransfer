<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Root StackPane: Lấp đầy cửa sổ -->

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.client.ClientController">

    <!-- Lớp 1: Background Image with Blur -->
    <!-- Đổi background thành background2.png -->
    <!-- ImageView: Neo vào tất cả các cạnh để lấp đầy -->
    <!-- Đặt StackPane.alignment="CENTER" TRỰC TIẾP trên thẻ ImageView -->
    <ImageView pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@images/background2.png" /> <!-- Đổi tên file ảnh -->
        </image>
        <effect>
            <GaussianBlur radius="1.0" /> <!-- Radius 1.0 -->
        </effect>
        <!-- Sử dụng Insets 0 để lấp đầy -->
         <StackPane.margin>
             <Insets bottom="0" left="0" right="0" top="0" />
         </StackPane.margin>
    </ImageView>

    <!-- Lớp 2: Main Content -->
    <!-- BorderPane: Lấp đầy StackPane -->
    <BorderPane>
        <!-- Phần TOP: Tiêu đề và Nút Log Out -->
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: rgba(0, 0, 0, 0.7);">
                 <padding> <Insets bottom="10" left="20" right="20" top="10" /> </padding>
                <!-- VBox chứa Label title và welcome, co giãn ngang -->
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="Manage Files" textFill="WHITE">
                        <font>
                            <Font name="Segoe UI" size="24.0" />
                        </font>
                    </Label>
                    <Label fx:id="welcomeLabel" text="TCP File transfer - Welcome!" textFill="WHITE">
                         <font>
                            <Font name="Segoe UI" size="14.0" />
                         </font>
                    </Label>
                </VBox>
                <!-- Nút Log Out -->
                <Button onAction="#handleLogout" stylesheets="@styling/fullPackStyling.css" text="Log Out" HBox.hgrow="NEVER" /> <!-- Nút không co giãn ngang -->
                 <HBox.margin>
                     <Insets left="20" />
                 </HBox.margin>
            </HBox>
        </top>

        <!-- Phần CENTER: Khu vực quản lý file -->
        <center>
            <!-- VBox ở Center: Chứa các control file management -->
            <VBox alignment="TOP_CENTER" spacing="10">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

                <!-- HBox chứa Tìm kiếm, Refresh, Select File -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="1598.0" spacing="10">
                     <!-- TextField tìm kiếm: co giãn ngang -->
                     <TextField fx:id="searchField" prefHeight="46.0" prefWidth="1599.0" promptText="Search filename or uploader" HBox.hgrow="ALWAYS">
                  <font>
                     <Font size="14.0" />
                  </font></TextField>
                </HBox>
                  <!-- TextField download: co giãn ngang -->
                  <TextField fx:id="downloadFilenameField" prefHeight="48.0" prefWidth="1600.0" promptText="Enter filename to download">
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>

                 <!-- HBox chứa Download Field và Download/Upload nút -->
                 <HBox alignment="CENTER_LEFT" spacing="10" />
            <HBox prefHeight="29.0" prefWidth="1564.0" spacing="25.0">
               <children>
                        <!-- Nút Refresh: không co giãn -->
                        <Button onAction="#handleRefresh" prefWidth="100" stylesheets="@styling/fullPackStyling.css" text="Refresh" HBox.hgrow="NEVER" />
                        <!-- Nút Select File: không co giãn -->
                        <Button onAction="#handleSelectFile" prefWidth="100" stylesheets="@styling/fullPackStyling.css" text="Select File" HBox.hgrow="NEVER" />
                        <Button fx:id="uploadButton" disable="true" onAction="#handleUpload" prefWidth="100" stylesheets="@styling/fullPackStyling.css" text="Upload" HBox.hgrow="NEVER" />
                        <!-- Nút Download: không co giãn -->
                        <Button fx:id="downloadButton" onAction="#handleDownload" prefWidth="100" stylesheets="@styling/fullPackStyling.css" text="Download" HBox.hgrow="NEVER" />
                        <!-- Nút Upload Selected: không co giãn -->
                        <Button fx:id="deleteButton" onAction="#handleDelete" prefWidth="100" stylesheets="@styling/fullPackStyling.css" text="Delete" HBox.hgrow="NEVER" />
                        <ProgressBar fx:id="progressBar" prefWidth="300" visible="false" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>


                <!-- TableView để hiển thị danh sách file -->
                <!-- TableView: Co giãn theo chiều dọc trong VBox -->
                <TableView fx:id="fileTableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <!-- Các cột TableView. prefWidth cung cấp kích thước ưu tiên. -->
                        <!-- CONSTRAINED_RESIZE_POLICY sẽ điều chỉnh chúng để lấp đầy TableView -->
                        <TableColumn prefWidth="200.0" text="File Name">
                            <cellValueFactory>
                                <PropertyValueFactory property="filename" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="100.0" text="Size">
                            <cellValueFactory>
                                <PropertyValueFactory property="formattedFileSize" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="100.0" text="Uploader">
                            <cellValueFactory>
                                <PropertyValueFactory property="uploader" />
                            </cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="150.0" text="Upload Time">
                            <cellValueFactory>
                                <PropertyValueFactory property="formattedUploadTime" />
                            </cellValueFactory>
                        </TableColumn>
                    </columns>
                     <placeholder>
                          <Label text="No files found on server." />
                     </placeholder>
                    <columnResizePolicy>
                         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </center>
    </BorderPane>
</StackPane>
